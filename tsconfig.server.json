{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/cli.ts",
    "src/commands/**/*",
    "src/backend/**/*",
    "src/config/**/*",
    "src/ssh/**/*",
    "src/audit/**/*",
    "src/mcp/**/*",
    "src/utils/**/*"
  ],
  "exclude": ["src/web/**/*", "node_modules", "dist", "dist-server"]
}
