{
  "name": "ssh-driver",
  "version": "0.2.0",
  "description": "让 AI Agent 安全地连接远程服务器并执行命令 —— SSH 连接管理 CLI + 网页控制台 + AI Skill",
  "keywords": [
    "ssh",
    "ssh-client",
    "remote-exec",
    "ai",
    "agent",
    "ai-agent",
    "skill",
    "cli",
    "automation",
    "devops",
    "sftp",
    "typescript"
  ],
  "homepage": "https://github.com/668mt/ssh-driver#readme",
  "bugs": {
    "url": "https://github.com/668mt/ssh-driver/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/668mt/ssh-driver.git"
  },
  "license": "MIT",
  "author": "Martin",
  "main": "dist/cli.js",
  "bin": {
    "ssh-driver": "dist/cli.js"
  },
  "files": [
    "dist",
    "dist-server",
    "skill",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "tsc --watch",
    "dev:web": "vite",
    "dev:console": "node dist/cli.js console --dev",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "node-ssh": "^13.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}