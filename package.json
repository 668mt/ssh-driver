{
  "name": "ssh-driver",
  "version": "0.2.0",
  "description": "SSH connection & command execution driver with AI skill support and web console",
  "main": "dist/cli.js",
  "bin": {
    "ssh-driver": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "tsc --watch",
    "dev:web": "vite",
    "dev:console": "node dist/cli.js console --dev",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "node-ssh": "^13.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  },
  "keywords": [
    "ssh",
    "ai",
    "agent",
    "cli",
    "console"
  ],
  "author": "Martin",
  "license": "MIT"
}
